rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAllowedUser() {
      return request.auth != null
        && request.auth.token.email in [
          'dan.croucher@gmail.com'
        ];
    }

    // Core data keys every client must write.
    function requiredStateKeys() {
      return [
        'version', 'rows', 'blocks', 'nextBlockId', 'nextRowId',
        'contingencyPct', 'projectStart', 'savedAt', 'updatedAt', 'updatedBy'
      ];
    }

    // Keys older clients still write (rowHeights, panelWidth, view prefs).
    // Allowed but no longer required, so stale open tabs keep working.
    function optionalStateKeys() {
      return [
        'zoom', 'panelWidth', 'headerWidth', 'resourceSummaryWidth',
        'collapsedRows', 'rowHeights'
      ];
    }

    function validBaseStateKeys() {
      return request.resource.data.keys().hasAll(requiredStateKeys())
        && request.resource.data.keys().hasOnly(
          requiredStateKeys().concat(optionalStateKeys()).concat(['_clientId'])
        );
    }

    function validBackupStateKeys() {
      return request.resource.data.keys().hasAll(requiredStateKeys())
        && request.resource.data.keys().hasOnly(
          requiredStateKeys().concat(optionalStateKeys())
            .concat(['backupReason', 'backupCreatedAt'])
        );
    }

    function optionalIntInRange(key, lo, hi) {
      return !(key in request.resource.data)
        || (request.resource.data[key] is int
            && request.resource.data[key] >= lo
            && request.resource.data[key] <= hi);
    }

    function optionalMap(key) {
      return !(key in request.resource.data)
        || request.resource.data[key] is map;
    }

    function hasValidStateShape() {
      return request.resource.data.version is int
        && request.resource.data.version >= 1
        && request.resource.data.rows is list
        && request.resource.data.rows.size() <= 200
        && request.resource.data.blocks is list
        && request.resource.data.blocks.size() <= 2000
        && request.resource.data.nextBlockId is int
        && request.resource.data.nextBlockId >= 1
        && request.resource.data.nextRowId is int
        && request.resource.data.nextRowId >= 1
        && request.resource.data.contingencyPct is int
        && request.resource.data.contingencyPct >= 0
        && request.resource.data.contingencyPct <= 100
        && request.resource.data.projectStart is string
        && request.resource.data.savedAt is int
        && (!('zoom' in request.resource.data)
            || request.resource.data.zoom in ['month', 'week', 'day', 'day-large', 'day-half', 'table'])
        && optionalIntInRange('panelWidth', 200, 800)
        && optionalIntInRange('headerWidth', 240, 720)
        && optionalIntInRange('resourceSummaryWidth', 88, 360)
        && optionalMap('collapsedRows')
        && optionalMap('rowHeights');
    }

    match /projects/blocks {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser()
        && validBaseStateKeys()
        && hasValidStateShape();
      allow delete: if false;

      match /backups/{backupId} {
        allow read: if isAllowedUser();
        allow create: if isAllowedUser()
          && validBackupStateKeys()
          && hasValidStateShape()
          && request.resource.data.backupReason is string;
        allow update, delete: if false;
      }
    }
  }
}
